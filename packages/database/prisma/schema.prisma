// =============================================================================
// Prisma Schema: Hệ thống Quản trị Nhân sự Thông minh BAHAU
// Trường Đại học Kiến trúc Đà Nẵng (DAU)
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS (14 Enums)
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UnitType {
  BOARD
  FACULTY
  DEPARTMENT
  DIVISION
  CENTER
}

enum PositionType {
  MANAGEMENT
  ACADEMIC
  ADMINISTRATIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicTitle {
  NONE
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum AcademicDegree {
  BACHELOR
  MASTER
  DOCTOR
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
}

enum AssignmentType {
  PRIMARY
  CONCURRENT
}

enum AssignmentStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ContractType {
  PROBATION
  DEFINITE_TERM_12M
  DEFINITE_TERM_36M
  INDEFINITE_TERM
  VISITING_LECTURER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum EmploymentEventType {
  HIRED
  APPOINTED
  TRANSFERRED
  CONCURRENT_ASSIGNED
  PROMOTED
  RESIGNED
  RETIRED
}

enum FileAccessLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WorkflowModule {
  LEAVE
  BUSINESS_TRIP
  PROFILE_UPDATE
  ATTENDANCE_ADJUSTMENT
  CERTIFICATE_VERIFY
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum WorkflowStepStatus {
  WAITING
  APPROVED
  REJECTED
  SKIPPED
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  ON_LEAVE
  BUSINESS_TRIP
  HOLIDAY
  WEEKEND
}

enum KpiPeriodStatus {
  DRAFT
  OPEN
  IN_REVIEW
  FINALIZED
}

enum KpiTargetType {
  LECTURER
  STAFF
}

enum KpiEvaluationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  FINALIZED
}

enum KpiRanking {
  EXCELLENT
  GOOD
  SATISFACTORY
  UNSATISFACTORY
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  UNPAID
  BEREAVEMENT
  WEDDING
  ACADEMIC
}

enum LeaveLedgerAction {
  GRANT_ANNUAL
  CARRY_FORWARD
  HOLD
  USE
  RESTORE
  EXPIRE
}

enum CertificateType {
  PROFESSIONAL_PRACTICE
  ACADEMIC_TITLE_DEGREE
  LANGUAGE
  INFORMATICS
  POLITICAL_THEORY
  OTHER
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum TrainingCategory {
  PEDAGOGY
  PROFESSIONAL
  POLITICAL
  LANGUAGE_IT
  OVERSEAS_POSTGRAD
}

enum TrainingCourseStatus {
  PLANNING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  APPROVED
  IN_PROGRESS
  COMPLETED
  FAILED
  DROPPED
}

enum NotificationType {
  SYSTEM
  WORKFLOW
  ALERT
  CONTRACT
  CERTIFICATE
  KPI
  TRAINING
}

// =============================================================================
// MODELS
// =============================================================================

// -----------------------------------------------------------------------------
// 1. Model User: Quản lý danh tính, xác thực và trạng thái đăng nhập
// -----------------------------------------------------------------------------
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  isMfaEnabled Boolean    @default(false)
  mfaSecret    String?    @db.VarChar(255)
  lastLoginAt  DateTime?  @db.Timestamptz
  createdAt    DateTime   @default(now()) @db.Timestamptz
  updatedAt    DateTime   @updatedAt @db.Timestamptz

  // Relations
  employee        Employee?
  sessions        Session[]
  roleAssignments RoleAssignment[]
  auditEvents     AuditEvent[]
  uploadedFiles   FileAsset[]
  notifications   Notification[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// 2. Model Session: Quản lý phiên làm việc stateful cookie HttpOnly
// -----------------------------------------------------------------------------
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 3. Model Role: Danh mục các vai trò hệ thống
// -----------------------------------------------------------------------------
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("roles")
}

// -----------------------------------------------------------------------------
// 4. Model Permission: Quyền hạn chi tiết theo module và action
// -----------------------------------------------------------------------------
model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  module    String   @db.VarChar(50)
  action    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

// -----------------------------------------------------------------------------
// 5. Model RolePermission: Bảng nối quan hệ Nhiều-Nhiều giữa Role và Permission
// -----------------------------------------------------------------------------
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 6. Model RoleAssignment: Phân vai trò kèm phạm vi đơn vị (Data Scope)
// -----------------------------------------------------------------------------
model RoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeUnitId String?   @db.Uuid
  validFrom   DateTime  @default(now()) @db.Date
  validTo     DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  // Relations
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeUnit OrganizationalUnit? @relation(fields: [scopeUnitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleId])
  @@index([scopeUnitId])
  @@index([validFrom, validTo])
  @@map("role_assignments")
}

// -----------------------------------------------------------------------------
// 7. Model OrganizationalUnit: Cơ cấu tổ chức cây đa cấp của Trường DAU
// -----------------------------------------------------------------------------
model OrganizationalUnit {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(255)
  unitType          UnitType
  parentId          String?  @db.Uuid
  managerEmployeeId String?  @db.Uuid
  isActive          Boolean  @default(true)
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  // Relations
  parent          OrganizationalUnit?    @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        OrganizationalUnit[]   @relation("UnitHierarchy")
  managerEmployee Employee?              @relation("UnitManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  assignments     EmploymentAssignment[]
  roleAssignments RoleAssignment[]
  fromEvents      EmploymentEvent[]      @relation("EventFromUnit")
  toEvents        EmploymentEvent[]      @relation("EventToUnit")

  @@index([parentId])
  @@index([managerEmployeeId])
  @@index([isActive])
  @@map("organizational_units")
}

// -----------------------------------------------------------------------------
// 8. Model Position: Danh mục chức vụ quản lý & chức danh chuyên môn
// -----------------------------------------------------------------------------
model Position {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique @db.VarChar(50)
  name            String       @db.VarChar(255)
  positionType    PositionType
  leadershipLevel Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz

  // Relations
  assignments EmploymentAssignment[]
  fromEvents  EmploymentEvent[]      @relation("EventFromPosition")
  toEvents    EmploymentEvent[]      @relation("EventToPosition")

  @@index([positionType])
  @@index([isActive])
  @@map("positions")
}

// -----------------------------------------------------------------------------
// 9. Model Employee: Hồ sơ thông tin Cán bộ Giảng viên Nhân viên toàn diện
// -----------------------------------------------------------------------------
model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String?          @unique @db.Uuid
  employeeCode     String           @unique @db.VarChar(50)
  fullName         String           @db.VarChar(255)
  gender           Gender
  dateOfBirth      DateTime         @db.Date
  idCardNumber     String           @unique @db.VarChar(20)
  idCardIssueDate  DateTime?        @db.Date
  idCardIssuePlace String?          @db.VarChar(255)
  taxCode          String?          @db.VarChar(20)
  personalEmail    String?          @db.VarChar(255)
  workEmail        String           @unique @db.VarChar(255)
  phoneNumber      String?          @db.VarChar(20)
  currentAddress   String?          @db.Text
  academicTitle    AcademicTitle    @default(NONE)
  academicDegree   AcademicDegree   @default(BACHELOR)
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime         @db.Date
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  // Relations
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments             EmploymentAssignment[]
  contracts               EmploymentContract[]
  events                  EmploymentEvent[]
  managedUnits            OrganizationalUnit[]   @relation("UnitManager")
  leaveRequests           LeaveRequest[]         @relation("EmployeeLeaveRequests")
  substituteLeaveRequests LeaveRequest[]         @relation("SubstituteEmployeeLeaveRequests")
  leaveLedgers            LeaveLedger[]
  businessTripRequests    BusinessTripRequest[]
  workflowRequests        WorkflowInstance[]     @relation("RequesterEmployeeWorkflows")
  assignedWorkflowSteps   WorkflowStep[]         @relation("ApproverEmployeeSteps")
  attendanceRecords       AttendanceRecord[]
  adjustmentRequests      AttendanceAdjustmentRequest[]
  monthlyTimesheets       MonthlyTimesheetSummary[]
  kpiEvaluations          KpiEvaluation[]               @relation("EmployeeKpiEvaluations")
  managedKpiEvaluations   KpiEvaluation[]               @relation("ManagerKpiEvaluations")
  certificates            Certificate[]                 @relation("EmployeeCertificates")
  verifiedCertificates    Certificate[]                 @relation("VerifierCertificates")
  trainingParticipations  TrainingParticipant[]

  @@index([employeeCode])
  @@index([workEmail])
  @@index([employmentStatus])
  @@index([fullName])
  @@index([hireDate])
  @@map("employees")
}

// -----------------------------------------------------------------------------
// 10. Model EmploymentAssignment: Phân công công tác chính thức & kiêm nhiệm
// -----------------------------------------------------------------------------
model EmploymentAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @db.Uuid
  unitId         String           @db.Uuid
  positionId     String           @db.Uuid
  assignmentType AssignmentType   @default(PRIMARY)
  isHeadOfUnit   Boolean          @default(false)
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @updatedAt @db.Timestamptz

  // Relations
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unit     OrganizationalUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  position Position           @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([unitId])
  @@index([positionId])
  @@index([assignmentType, status])
  @@index([status, startDate, endDate])
  @@map("employment_assignments")
}

// -----------------------------------------------------------------------------
// 11. Model EmploymentContract: Quản lý hợp đồng lao động & chuỗi gia hạn
// -----------------------------------------------------------------------------
model EmploymentContract {
  id                String         @id @default(uuid()) @db.Uuid
  employeeId        String         @db.Uuid
  contractNumber    String         @unique @db.VarChar(100)
  contractType      ContractType
  signedDate        DateTime       @db.Date
  effectiveDate     DateTime       @db.Date
  expiryDate        DateTime?      @db.Date
  salaryCoefficient Decimal        @db.Decimal(5, 2)
  status            ContractStatus @default(ACTIVE)
  fileAssetId       String?        @db.Uuid
  parentContractId  String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  // Relations
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parentContract   EmploymentContract?  @relation("ContractRenewal", fields: [parentContractId], references: [id], onDelete: SetNull)
  renewedContracts EmploymentContract[] @relation("ContractRenewal")
  fileAsset        FileAsset?           @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status, expiryDate])
  @@index([fileAssetId])
  @@index([parentContractId])
  @@map("employment_contracts")
}

// -----------------------------------------------------------------------------
// 12. Model EmploymentEvent: Lịch sử biến động công tác (Timeline)
// -----------------------------------------------------------------------------
model EmploymentEvent {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String              @db.Uuid
  eventType      EmploymentEventType
  decisionNumber String?             @db.VarChar(100)
  decisionDate   DateTime?           @db.Date
  effectiveDate  DateTime            @db.Date
  fromUnitId     String?             @db.Uuid
  toUnitId       String?             @db.Uuid
  fromPositionId String?             @db.Uuid
  toPositionId   String?             @db.Uuid
  note           String?             @db.Text
  fileAssetId    String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz

  // Relations
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromUnit     OrganizationalUnit? @relation("EventFromUnit", fields: [fromUnitId], references: [id], onDelete: SetNull)
  toUnit       OrganizationalUnit? @relation("EventToUnit", fields: [toUnitId], references: [id], onDelete: SetNull)
  fromPosition Position?           @relation("EventFromPosition", fields: [fromPositionId], references: [id], onDelete: SetNull)
  toPosition   Position?           @relation("EventToPosition", fields: [toPositionId], references: [id], onDelete: SetNull)
  fileAsset    FileAsset?          @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([effectiveDate])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([fromPositionId])
  @@index([toPositionId])
  @@index([fileAssetId])
  @@map("employment_events")
}

// -----------------------------------------------------------------------------
// 13. Model FileAsset: Metadata tệp đính kèm bảo mật
// -----------------------------------------------------------------------------
model FileAsset {
  id               String          @id @default(uuid()) @db.Uuid
  originalFileName String          @db.VarChar(255)
  storedFileName   String          @db.VarChar(255)
  mimeType         String          @db.VarChar(100)
  fileSizeBytes    BigInt
  sha256Checksum   String          @db.VarChar(64)
  storagePath      String          @db.VarChar(500)
  accessLevel      FileAccessLevel @default(INTERNAL)
  uploadedByUserId String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz

  // Relations
  uploadedByUser User?                @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  contracts      EmploymentContract[]
  events         EmploymentEvent[]

  @@index([uploadedByUserId])
  @@index([sha256Checksum])
  @@map("file_assets")
}

// -----------------------------------------------------------------------------
// 14. Model OutboxEvent: Hàng đợi sự kiện giao dịch (Transactional Outbox)
// -----------------------------------------------------------------------------
model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  aggregateType  String       @db.VarChar(100)
  aggregateId    String       @db.Uuid
  eventType      String       @db.VarChar(100)
  payload        Json         @db.JsonB
  idempotencyKey String       @unique @db.VarChar(255)
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0)
  lastError      String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz
  processedAt    DateTime?    @db.Timestamptz

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// -----------------------------------------------------------------------------
// 15. Model AuditEvent: Nhật ký kiểm toán bảo mật & truy vết thay đổi dữ liệu
// -----------------------------------------------------------------------------
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityName String   @db.VarChar(100)
  entityId   String   @db.Uuid
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.Text
  diffData   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @db.Timestamptz

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// 16. Model WorkflowInstance: Phiên phê duyệt đa cấp theo quy trình
// -----------------------------------------------------------------------------
model WorkflowInstance {
  id                  String         @id @default(uuid()) @db.Uuid
  module              WorkflowModule
  recordId            String         @db.Uuid
  requesterEmployeeId String         @db.Uuid
  currentStepIndex    Int            @default(0)
  status              WorkflowStatus @default(PENDING)
  createdAt           DateTime       @default(now()) @db.Timestamptz
  updatedAt           DateTime       @updatedAt @db.Timestamptz

  // Relations
  requesterEmployee Employee       @relation("RequesterEmployeeWorkflows", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  steps             WorkflowStep[]

  @@index([module, recordId])
  @@index([requesterEmployeeId])
  @@index([status])
  @@map("workflow_instances")
}

// -----------------------------------------------------------------------------
// 17. Model WorkflowStep: Từng bước phê duyệt tuần tự
// -----------------------------------------------------------------------------
model WorkflowStep {
  id                 String             @id @default(uuid()) @db.Uuid
  instanceId         String             @db.Uuid
  stepIndex          Int
  stepName           String             @db.VarChar(100)
  approverRoleCode   String?            @db.VarChar(50)
  approverEmployeeId String?            @db.Uuid
  status             WorkflowStepStatus @default(WAITING)
  comment            String?            @db.Text
  actionAt           DateTime?          @db.Timestamptz
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  // Relations
  instance         WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  approverEmployee Employee?        @relation("ApproverEmployeeSteps", fields: [approverEmployeeId], references: [id], onDelete: SetNull)

  @@index([instanceId, stepIndex])
  @@index([approverEmployeeId, status])
  @@map("workflow_steps")
}

// -----------------------------------------------------------------------------
// 18. Model LeaveRequest: Đơn xin nghỉ phép
// -----------------------------------------------------------------------------
model LeaveRequest {
  id                   String         @id @default(uuid()) @db.Uuid
  employeeId           String         @db.Uuid
  leaveType            LeaveType
  startDate            DateTime       @db.Date
  endDate              DateTime       @db.Date
  totalDays            Decimal        @db.Decimal(4, 1)
  reason               String         @db.Text
  substituteEmployeeId String?        @db.Uuid
  workflowInstanceId   String?        @unique @db.Uuid
  status               WorkflowStatus @default(PENDING)
  createdAt            DateTime       @default(now()) @db.Timestamptz
  updatedAt            DateTime       @updatedAt @db.Timestamptz

  // Relations
  employee           Employee      @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  substituteEmployee Employee?     @relation("SubstituteEmployeeLeaveRequests", fields: [substituteEmployeeId], references: [id], onDelete: SetNull)
  ledgerEntries      LeaveLedger[]

  @@index([employeeId])
  @@index([startDate, endDate])
  @@index([status])
  @@map("leave_requests")
}

// -----------------------------------------------------------------------------
// 19. Model LeaveLedger: Sổ cái số dư ngày phép bất biến (Double-entry Ledger)
// -----------------------------------------------------------------------------
model LeaveLedger {
  id                     String            @id @default(uuid()) @db.Uuid
  employeeId             String            @db.Uuid
  year                   Int
  action                 LeaveLedgerAction
  amount                 Decimal           @db.Decimal(4, 1)
  balanceAfter           Decimal           @db.Decimal(4, 1)
  referenceLeaveRequestId String?           @db.Uuid
  note                   String?           @db.VarChar(255)
  createdAt              DateTime          @default(now()) @db.Timestamptz

  // Relations
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [referenceLeaveRequestId], references: [id], onDelete: SetNull)

  @@index([employeeId, year])
  @@index([referenceLeaveRequestId])
  @@map("leave_ledgers")
}

// -----------------------------------------------------------------------------
// 20. Model BusinessTripRequest: Đơn đăng ký đi công tác
// -----------------------------------------------------------------------------
model BusinessTripRequest {
  id                 String         @id @default(uuid()) @db.Uuid
  employeeId         String         @db.Uuid
  purpose            String         @db.Text
  destination        String         @db.VarChar(255)
  startDate          DateTime       @db.Date
  endDate            DateTime       @db.Date
  totalDays          Decimal        @db.Decimal(4, 1)
  budgetEstimate     Decimal?       @db.Decimal(12, 2)
  fundingSource      String?        @db.VarChar(100)
  workflowInstanceId String?        @unique @db.Uuid
  status             WorkflowStatus @default(PENDING)
  createdAt          DateTime       @default(now()) @db.Timestamptz
  updatedAt          DateTime       @updatedAt @db.Timestamptz

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([startDate, endDate])
  @@index([status])
  @@map("business_trip_requests")
}

// -----------------------------------------------------------------------------
// 21. Model AttendancePeriod: Quản lý kỳ công tháng & trạng thái khóa kỳ
// -----------------------------------------------------------------------------
model AttendancePeriod {
  id                  String                    @id @default(uuid()) @db.Uuid
  month               Int                       @db.SmallInt
  year                Int                       @db.SmallInt
  startDate           DateTime                  @db.Date
  endDate             DateTime                  @db.Date
  standardWorkingDays Decimal                   @default(22) @db.Decimal(4, 1)
  isLocked            Boolean                   @default(false)
  lockedAt            DateTime?                 @db.Timestamptz
  lockedById          String?                   @db.Uuid
  note                String?                   @db.VarChar(255)
  createdAt           DateTime                  @default(now()) @db.Timestamptz
  updatedAt           DateTime                  @updatedAt @db.Timestamptz

  // Relations
  records             AttendanceRecord[]
  timesheetSummaries  MonthlyTimesheetSummary[]

  @@unique([year, month])
  @@index([isLocked])
  @@map("attendance_periods")
}

// -----------------------------------------------------------------------------
// 22. Model AttendanceRecord: Lớp 1 - Điểm danh quẹt thẻ hàng ngày
// -----------------------------------------------------------------------------
model AttendanceRecord {
  id                  String                       @id @default(uuid()) @db.Uuid
  employeeId          String                       @db.Uuid
  periodId            String?                      @db.Uuid
  workDate            DateTime                     @db.Date
  checkInTime         DateTime?                    @db.Timestamptz
  checkOutTime        DateTime?                    @db.Timestamptz
  rawWorkingHours     Decimal                      @default(0) @db.Decimal(4, 2)
  status              AttendanceStatus             @default(PRESENT)
  deviceSource        String?                      @db.VarChar(100)
  importBatchId       String?                      @db.VarChar(100)
  adjustmentRequestId String?                      @unique @db.Uuid
  createdAt           DateTime                     @default(now()) @db.Timestamptz
  updatedAt           DateTime                     @updatedAt @db.Timestamptz

  // Relations
  employee            Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period              AttendancePeriod?            @relation(fields: [periodId], references: [id], onDelete: SetNull)
  adjustmentRequest   AttendanceAdjustmentRequest? @relation(fields: [adjustmentRequestId], references: [id], onDelete: SetNull)

  @@unique([employeeId, workDate])
  @@index([periodId])
  @@index([workDate])
  @@index([status])
  @@map("attendance_records")
}

// -----------------------------------------------------------------------------
// 23. Model AttendanceAdjustmentRequest: Lớp 2 - Đơn giải trình / điều chỉnh giờ công
// -----------------------------------------------------------------------------
model AttendanceAdjustmentRequest {
  id                  String            @id @default(uuid()) @db.Uuid
  employeeId          String            @db.Uuid
  workDate            DateTime          @db.Date
  originalCheckIn     DateTime?         @db.Timestamptz
  originalCheckOut    DateTime?         @db.Timestamptz
  adjustedCheckIn     DateTime?         @db.Timestamptz
  adjustedCheckOut    DateTime?         @db.Timestamptz
  reason              String            @db.Text
  workflowInstanceId  String?           @unique @db.Uuid
  status              WorkflowStatus    @default(PENDING)
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime          @updatedAt @db.Timestamptz

  // Relations
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecord    AttendanceRecord?

  @@index([employeeId])
  @@index([workDate])
  @@index([status])
  @@map("attendance_adjustment_requests")
}

// -----------------------------------------------------------------------------
// 24. Model MonthlyTimesheetSummary: Lớp 3 - Bảng công tổng hợp chốt tháng
// -----------------------------------------------------------------------------
model MonthlyTimesheetSummary {
  id                  String            @id @default(uuid()) @db.Uuid
  employeeId          String            @db.Uuid
  periodId            String            @db.Uuid
  standardDays        Decimal           @default(22) @db.Decimal(4, 1)
  actualWorkingDays   Decimal           @default(0) @db.Decimal(4, 1)
  paidLeaveDays       Decimal           @default(0) @db.Decimal(4, 1)
  unpaidLeaveDays     Decimal           @default(0) @db.Decimal(4, 1)
  businessTripDays    Decimal           @default(0) @db.Decimal(4, 1)
  lateCount           Int               @default(0)
  earlyLeaveCount     Int               @default(0)
  totalPayableDays    Decimal           @default(0) @db.Decimal(4, 1)
  isFinalized         Boolean           @default(false)
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime          @updatedAt @db.Timestamptz

  // Relations
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period              AttendancePeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodId])
  @@index([periodId])
  @@map("monthly_timesheet_summaries")
}

// -----------------------------------------------------------------------------
// 25. Model KpiPeriod: Quản lý kỳ đánh giá (Học kỳ / Năm học)
// -----------------------------------------------------------------------------
model KpiPeriod {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique @db.VarChar(50)
  name         String          @db.VarChar(255)
  academicYear String          @db.VarChar(20)
  semester     String?         @db.VarChar(20)
  startDate    DateTime        @db.Date
  endDate      DateTime        @db.Date
  status       KpiPeriodStatus @default(OPEN)
  createdAt    DateTime        @default(now()) @db.Timestamptz
  updatedAt    DateTime        @updatedAt @db.Timestamptz

  // Relations
  evaluations KpiEvaluation[]

  @@index([status])
  @@index([academicYear])
  @@map("kpi_periods")
}

// -----------------------------------------------------------------------------
// 26. Model KpiTemplate: Mẫu tiêu chí đánh giá theo đối tượng (Giảng viên / Chuyên viên)
// -----------------------------------------------------------------------------
model KpiTemplate {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(255)
  targetType    KpiTargetType
  description   String?       @db.Text
  totalMaxScore Decimal       @default(100) @db.Decimal(5, 1)
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  // Relations
  criteria    KpiCriterion[]
  evaluations KpiEvaluation[]

  @@index([targetType])
  @@map("kpi_templates")
}

// -----------------------------------------------------------------------------
// 27. Model KpiCriterion: Từng tiêu chí con của mẫu đánh giá
// -----------------------------------------------------------------------------
model KpiCriterion {
  id          String      @id @default(uuid()) @db.Uuid
  templateId  String      @db.Uuid
  orderIndex  Int         @default(0)
  category    String      @db.VarChar(100)
  name        String      @db.VarChar(255)
  description String?     @db.Text
  maxScore    Decimal     @db.Decimal(5, 1)
  weight      Decimal     @default(1) @db.Decimal(4, 2)
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  // Relations
  template KpiTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    KpiEvaluationItem[]

  @@index([templateId, orderIndex])
  @@map("kpi_criteria")
}

// -----------------------------------------------------------------------------
// 28. Model KpiEvaluation: Phiếu đánh giá cá nhân theo kỳ
// -----------------------------------------------------------------------------
model KpiEvaluation {
  id                String              @id @default(uuid()) @db.Uuid
  periodId          String              @db.Uuid
  templateId        String              @db.Uuid
  employeeId        String              @db.Uuid
  managerEmployeeId String?             @db.Uuid
  status            KpiEvaluationStatus @default(DRAFT)
  totalSelfScore    Decimal?            @db.Decimal(5, 1)
  totalManagerScore Decimal?            @db.Decimal(5, 1)
  totalFinalScore   Decimal?            @db.Decimal(5, 1)
  ranking           KpiRanking?
  managerComment    String?             @db.Text
  councilComment    String?             @db.Text
  submittedAt       DateTime?           @db.Timestamptz
  reviewedAt        DateTime?           @db.Timestamptz
  finalizedAt       DateTime?           @db.Timestamptz
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz

  // Relations
  period          KpiPeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  template        KpiTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  employee        Employee            @relation("EmployeeKpiEvaluations", fields: [employeeId], references: [id], onDelete: Cascade)
  managerEmployee Employee?           @relation("ManagerKpiEvaluations", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  items           KpiEvaluationItem[]

  @@unique([periodId, employeeId])
  @@index([periodId])
  @@index([employeeId])
  @@index([status])
  @@index([ranking])
  @@map("kpi_evaluations")
}

// -----------------------------------------------------------------------------
// 29. Model KpiEvaluationItem: Chi tiết điểm và minh chứng từng tiêu chí
// -----------------------------------------------------------------------------
model KpiEvaluationItem {
  id           String   @id @default(uuid()) @db.Uuid
  evaluationId String   @db.Uuid
  criterionId  String   @db.Uuid
  selfScore    Decimal? @db.Decimal(5, 1)
  managerScore Decimal? @db.Decimal(5, 1)
  finalScore   Decimal? @db.Decimal(5, 1)
  selfNote     String?  @db.Text
  evidenceUrl  String?  @db.VarChar(500)
  managerNote  String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  // Relations
  evaluation KpiEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  KpiCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
  @@index([criterionId])
  @@map("kpi_evaluation_items")
}

// -----------------------------------------------------------------------------
// 30. Model Certificate: Quản lý chứng chỉ hành nghề, chức danh & năng lực CBGV
// -----------------------------------------------------------------------------
model Certificate {
  id                String            @id @default(uuid()) @db.Uuid
  employeeId        String            @db.Uuid
  certificateType   CertificateType
  name              String            @db.VarChar(255)
  certificateNumber String            @db.VarChar(100)
  issuedBy          String            @db.VarChar(255)
  issuedDate        DateTime          @db.Date
  expiryDate        DateTime?         @db.Date
  score             String?           @db.VarChar(50)
  fileUrl           String?           @db.VarChar(500)
  status            CertificateStatus @default(PENDING)
  verifiedById      String?           @db.Uuid
  verifiedAt        DateTime?         @db.Timestamptz
  rejectionReason   String?           @db.Text
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  // Relations
  employee   Employee  @relation("EmployeeCertificates", fields: [employeeId], references: [id], onDelete: Cascade)
  verifiedBy Employee? @relation("VerifierCertificates", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([certificateType])
  @@index([status])
  @@index([expiryDate])
  @@map("certificates")
}

// -----------------------------------------------------------------------------
// 31. Model TrainingCourse: Khóa bồi dưỡng chuyên môn, sư phạm & Đề án 89
// -----------------------------------------------------------------------------
model TrainingCourse {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(50)
  name        String               @db.VarChar(255)
  category    TrainingCategory
  provider    String               @db.VarChar(255)
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  location    String?              @db.VarChar(255)
  budget      Decimal?             @default(0) @db.Decimal(15, 2)
  status      TrainingCourseStatus @default(PLANNING)
  description String?              @db.Text
  createdAt   DateTime             @default(now()) @db.Timestamptz
  updatedAt   DateTime             @updatedAt @db.Timestamptz

  // Relations
  participants TrainingParticipant[]

  @@index([category])
  @@index([status])
  @@index([startDate, endDate])
  @@map("training_courses")
}

// -----------------------------------------------------------------------------
// 32. Model TrainingParticipant: Danh sách CBGV tham gia khóa bồi dưỡng
// -----------------------------------------------------------------------------
model TrainingParticipant {
  id                String            @id @default(uuid()) @db.Uuid
  courseId          String            @db.Uuid
  employeeId        String            @db.Uuid
  status            ParticipantStatus @default(REGISTERED)
  grade             String?           @db.VarChar(50)
  certificateIssued Boolean           @default(false)
  note              String?           @db.Text
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  // Relations
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([courseId])
  @@index([employeeId])
  @@index([status])
  @@map("training_participants")
}

// -----------------------------------------------------------------------------
// 33. Model Notification: Thông báo người dùng từ hệ thống và tiến trình Outbox
// -----------------------------------------------------------------------------
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String           @db.VarChar(255)
  content   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  metadata  Json?            @db.JsonB
  createdAt DateTime         @default(now()) @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// 34. Model PolicyKnowledge: Cơ sở tri thức quy chế & pháp quy DAU cho AI Assistant RAG
// -----------------------------------------------------------------------------
model PolicyKnowledge {
  id            String    @id @default(uuid()) @db.Uuid
  documentNo    String    @db.VarChar(100)
  title         String    @db.VarChar(255)
  category      String    @db.VarChar(100)
  chunkText     String    @db.Text
  keywords      String[]
  metadata      Json?     @db.JsonB
  effectiveDate DateTime? @db.Date
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([category])
  @@index([documentNo])
  @@map("policy_knowledge")
}
