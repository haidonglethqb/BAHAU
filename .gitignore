# =============================================================================
# BAHAU - Hệ thống Quản trị Nhân sự Thông minh (DAU)
# .gitignore chuẩn hóa cho Monorepo (Next.js, Express, Prisma, TypeScript)
# =============================================================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnpm-store/
.npm/

# 2. Production & Compiler Outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
*.tsbuildinfo
**/*.tsbuildinfo
*.d.ts.map
**/*.d.ts.map

# 3. Environment & Credentials
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
# Giữ lại file mẫu môi trường
!.env.example

# 4. Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/.logs/
hook-log.jsonl

# 5. Testing, Coverage & Reports
coverage/
**/coverage/
*.lcov
.nyc_output/
tests/e2e/reports/*
!tests/e2e/reports/.gitkeep

# 6. Database & Local Storage
storage/uploads/*
!storage/uploads/.gitkeep
postgres_data/
pgdata/
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# 7. Python Scripts Cache (Agent Skills)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 8. Temporary & Scratch Files
tmp/
temp/
.temp/
*.tmp
*.bak
*.swp
*~

# 9. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 10. IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# 11. Monorepo & AI Tools Ephemeral Runs
.turbo/
.vercel/
.eslintcache/
# Bỏ qua các thư mục chạy tạm của subagents, giữ lại skills và request gốc
.agents/*/
!.agents/skills/
!.agents/ORIGINAL_REQUEST.md
